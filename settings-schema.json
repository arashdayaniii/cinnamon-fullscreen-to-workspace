{
  "header-shortcuts": {
    "type": "header",
    "description": "Keyboard Shortcuts"
  },
  "exit-hotkey": {
    "type": "keybinding",
    "default": "<Super>f",
    "description": "Toggle App Space (Fullscreen to Workspace)",
    "tooltip": "Sends the focused window to a dedicated fullscreen App Space, or returns it to its original workspace if already in one."
  },
  "header-debug": {
    "type": "header",
    "description": "Diagnostics"
  },
  "enable-logs": {
    "type": "switch",
    "default": false,
    "description": "Enable debug logging in ~/.xsession-errors"
  }
}
